{
  "name": "fluxy",
  "version": "0.2.0-alpha.2",
  "description": "Local-first LAN transfer for desktop and Android",
  "type": "module",
  "packageManager": "bun@1.4.3",
  "scripts": {
    "start": "vite",
    "dev:web": "node scripts/dev-web.mjs",
    "build:vite": "vite build && node scripts/css-legacy.mjs",
    "build": "tauri build",
    "serve": "vite preview",
    "tauri": "tauri",
    "dev": "tauri dev",
    "check": "tsc --noEmit && node scripts/check-code-limits.mjs && node scripts/css-legacy.mjs --self-test",
    "format": "biome format --write .",
    "check:format": "biome format .",
    "check:limits": "node scripts/check-code-limits.mjs",
    "check:security": "bun scripts/check-ui-security.mjs",
    "audit": "node scripts/security/audit.mjs",
    "check:docs": "node scripts/check-docs-links.mjs",
    "check:versions": "node scripts/release/verify-versions.mjs",
    "soak": "node scripts/soak/soak.mjs",
    "android:build": "node scripts/android/build-apk.mjs",
    "android:keystore": "node scripts/android/keystore.mjs",
    "test": "bun run test:rust && bun run test:frontend",
    "test:rust": "cargo test --workspace",
    "test:frontend": "vitest run",
    "test:frontend:watch": "vitest",
    "test:e2e": "node scripts/e2e/e2e.mjs local"
  },
  "license": "AGPL-3.0-only",
  "dependencies": {
    "@solidjs/router": "^1.0.1",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-barcode-scanner": "2.5.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-solid": "^1.68.0",
    "solid-js": "^1.9.18",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@babel/parser": "^8.1.0",
    "@biomejs/biome": "^2.6.4",
    "@csstools/postcss-cascade-layers": "^6.0.2",
    "@csstools/postcss-color-mix-function": "^4.0.16",
    "@csstools/postcss-media-minmax": "^3.0.8",
    "@csstools/postcss-oklab-function": "^5.0.16",
    "@solidjs/testing-library": "^0.8.10",
    "@tailwindcss/vite": "^4.3.4",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/jest-dom": "^7.0.1",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.4",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-solid": "^2.11.15",
    "vitest": "^5.1.0"
  }
}
